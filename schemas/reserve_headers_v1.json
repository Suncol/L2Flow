  },
  "validation": {
    "binding_rules": [
      "Every decoded reserve_state_uuid, device_id, quota_identity_sha256, and mount_identity_sha256 is nonzero.",
      "Attach compares the complete pool identity tuple exactly with the retained coordinator/state identity; mount paths are not identities.",
      "ReserveFileHeaderV1 declared_bytes is at least 4096 and attach requires st_size == declared_bytes.",
      "ReserveInodeHeaderV1 count is in [1,100000000], index is strictly less than count, and attach compares count with the immutable state inventory count.",
      "The exact retained filename must be the canonical filename derived from the header UUID and index.",
      "All reserved bytes are zero even when CRC-consistent, and CRC is checked over all 4096 bytes with only the CRC field treated as zero.",
      "The inode header repeats device and mount identity in addition to the required quota identity so an inode artifact cannot be rebound across allocation pools."
    ],
    "filename_rules": [
      "Uppercase hexadecimal, signs, whitespace, non-decimal index characters, missing zero padding, alternate widths, suffixes, and all-zero UUIDs are rejected.",
      "For one UUID, bytewise lexical filename order equals numeric index order because the decimal index has fixed width."
    ],
    "wire_rules": [
      "Integers are encoded explicitly little-endian; a host C++ object representation is never a wire encoding.",
      "Unknown version/endian/header-size values and any byte length other than exactly 4096 are rejected.",
      "A failed decode does not modify the caller output."
    ]
  }
