{
  "byte_order": "little-endian",
  "crc32c": {
    "algorithm": "CRC-32C/Castagnoli",
    "domain_length": 4096,
    "domain_offset": 0,
    "field_offset": 112,
    "field_width": 4,
    "field_zeroed_during_calculation": true,
    "init_hex": "0xffffffff",
    "polynomial_normal_hex": "0x1edc6f41",
    "polynomial_reflected_hex": "0x82f63b78",
    "refin": true,
    "refout": true,
    "stored_encoding": "u32-le",
    "xorout_hex": "0xffffffff"
  },
  "filename_grammars": {
    "reserve_inode_v1": {
      "canonical_form": "inode-<reserve_uuid_hex>-<index_decimal>.reserve",
      "exact_length": 55,
      "index_decimal": {
        "digits": 8,
        "maximum": 99999999,
        "minimum": 0,
        "radix": 10,
        "zero_padded": true
      },
      "lexical_order_equals_index_order_for_one_uuid": true,
      "pattern": "^inode-[0-9a-f]{32}-[0-9]{8}\\.reserve$",
      "reserve_uuid_hex": {
        "case": "lowercase",
        "digits": 32,
        "nonzero": true,
        "radix": 16,
        "wire_byte_order": "identity byte order; no UUID field swapping"
      }
    }
  },
  "format_identity": {
    "name": "ReserveAllocationHeadersV1",
    "scope": "L2Flow repository-private disk formats",
    "standard": false,
    "version": 1
  },
  "golden_inputs": {
    "common_pool_identity": {
      "device_id_hex": "0x0102030405060708",
      "mount_identity_sha256_bytes": "40,41,...,5f",
      "quota_identity_sha256_bytes": "20,21,...,3f",
      "reserve_state_uuid_bytes": "01,02,...,10"
    },
    "reserve_file_header_v1": {
      "declared_bytes_hex": "0x0102030405061000"
    },
    "reserve_inode_header_v1": {
      "declared_inode_reserve_count": 1000,
      "inode_index": 42
    }
  },
  "layouts": {
