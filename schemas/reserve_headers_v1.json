        },
        {
          "encoding": "u16-le",
          "name": "version",
          "offset": 8,
          "value": 1,
          "width": 2
        },
        {
          "encoding": "u8",
          "name": "endian",
          "offset": 10,
          "value": 1,
          "width": 1
